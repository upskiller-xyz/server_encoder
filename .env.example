
# GCP project ID
PROJECT_ID=xx
GCP_REGION=xx
REPO_NAME=xx-server-docker-repo
IMAGE_NAME=daylight-xx-img
SERVER_NAME=xx-server
# ============================================================================
# Scaleway (SCW) Variables
# Used in: build_scw.sh
# ============================================================================


SCW_PROJECT_ID=xx
SCW_REGISTRY_NAMESPACE=upskiller-nsp
SCW_SERVER=serve-xx-container
SCW_IMAGE=xx-server-image
SCW_SERVE_CONTAINER_NAME=serve-xxx-container

# HTTP hardening (src/server/http_policy.py)
# MAX_CONTENT_LENGTH_BYTES: request bodies above this are rejected with 413.
# CORS_ORIGINS: comma-separated browser origins; empty = no CORS (server-to-server only).
# FLASK_DEBUG: Werkzeug debugger for `python src/main.py` only — never in production.
# MAX_CONTENT_LENGTH_BYTES=67108864
# CORS_ORIGINS=
# FLASK_DEBUG=false
